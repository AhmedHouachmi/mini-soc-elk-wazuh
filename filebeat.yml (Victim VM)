filebeat.inputs:
  - type: log
    enabled: true
    paths:
      - /var/log/snort/snort.alert
    fields:
      event.module: snort
    multiline.pattern: '^\d{2}/\d{2}'
    multiline.negate: true
    multiline.match: after

output.logstash:
  hosts: ["192.168.198.128:5044"]
  ssl.enabled: false

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
